@model PlotboekModel

<!-- Plotboek Settings Accordion -->
<div class="row mb-4">
    <div class="col-12">
        <div class="accordion" id="plotboekSettingsAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header" id="plotboekSettingsHeader">
                    <button class="accordion-button @(string.IsNullOrEmpty(Model.GoogleDriveUploadMessage) ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#plotboekSettingsContent" aria-expanded="@(!string.IsNullOrEmpty(Model.GoogleDriveUploadMessage) ? "true" : "false")" aria-controls="plotboekSettingsContent">
                        <i class="fas fa-cog me-2"></i>Plotboek Instellingen & Acties
                    </button>
                </h2>
                <div id="plotboekSettingsContent" class="accordion-collapse collapse @(!string.IsNullOrEmpty(Model.GoogleDriveUploadMessage) ? "show" : "")" aria-labelledby="plotboekSettingsHeader" data-bs-parent="#plotboekSettingsAccordion">
                    <div class="accordion-body">
                        @if (!string.IsNullOrEmpty(Model.GoogleDriveUploadMessage))
                        {
                            <div class="alert @(Model.GoogleDriveUploadSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                                <i class="fas @(Model.GoogleDriveUploadSuccess ? "fa-check-circle" : "fa-exclamation-circle") me-1"></i>
                                @Model.GoogleDriveUploadMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (Model.IsNpc)
                        {
                            <h6 class="text-secondary mb-3">Plotboek Overzicht</h6>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Voorblad Afbeelding:</label>
                                    @if (Model.HasVoorblad)
                                    {
                                        <div>
                                            <img src="@Url.Page("/Plotboek", "VoorbladAfbeelding", new { Jaar = Model.Jaar, Event = Model.EventId })"
                                                 alt="Voorblad"
                                                 class="img-thumbnail"
                                                 style="max-height: 200px;" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted fst-italic">Er is geen voorbladafbeelding ingesteld.</div>
                                    }
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-12 mb-1">
                                    <label class="form-label fw-bold">Samenvatting Algemeen Plot:</label>
                                </div>
                                <div class="col-12">
                                    @if (!string.IsNullOrWhiteSpace(Model.PlotboekSettings?.SamenvattingAlgemeenPlot))
                                    {
                                        <div class="border rounded p-3 bg-body-tertiary attempted-change-html">@Html.Raw(Model.PlotboekSettings.SamenvattingAlgemeenPlot)</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted fst-italic">Er is nog geen algemene samenvatting beschikbaar.</div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                        <!-- Action Buttons -->
                        <div class="mb-4">
                            <h6 class="text-secondary mb-3">Acties</h6>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @if (!Model.IsEvergreen)
                                {
                                <form method="post" style="display: inline;">
                                    <input type="hidden" name="Jaar" value="@Model.Jaar" />
                                    <input type="hidden" name="Event" value="@Model.EventId" />
                                    <input type="hidden" name="Action" value="exportDocx" />
                                    <button type="submit" class="btn btn-outline-primary">
                                        <i class="fas fa-file-word me-1"></i> Export DOCX
                                    </button>
                                </form>
                                    @if (!Model.IsPlotboekReadOnly && !string.IsNullOrWhiteSpace(Model.PlotboekSettings?.GoogleDriveFolderUrl))
                                    {
                                <form method="post" style="display: inline;">
                                    <input type="hidden" name="Jaar" value="@Model.Jaar" />
                                    <input type="hidden" name="Event" value="@Model.EventId" />
                                    <input type="hidden" name="PaginaId" value="@Model.PaginaId" />
                                    <input type="hidden" name="Action" value="uploadToDrive" />
                                    <button type="submit" class="btn btn-outline-success" @(!Model.GoogleDriveConfigured ? "disabled" : "") title="@(!Model.GoogleDriveConfigured ? "Google Drive service account is niet geconfigureerd op de server." : "")">
                                        <i class="fab fa-google-drive me-1"></i> Upload naar Google Drive
                                    </button>
                                </form>
                                        @if (!string.IsNullOrWhiteSpace(Model.PlotboekSettings?.GoogleDriveFileUrl))
                                        {
                                <a href="@Model.PlotboekSettings.GoogleDriveFileUrl" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-outline-info"
                                   title="Open het laatst geüploade bestand in Google Drive">
                                    <i class="fab fa-google-drive me-1"></i> Bekijk in Google Drive
                                </a>
                                        }
                                    }
                                }
                                <a href="@Url.Page("/Plotboek", new { Jaar = Model.Jaar, Event = Model.EventId, PaginaId = Model.PaginaId, ShowPlotboekAuditTrail = true })"
                                   class="btn btn-outline-secondary">
                                    <i class="fas fa-history me-1"></i> Wijzigingen
                                </a>
                                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#slOverzichtModal">
                                    <i class="fas fa-user-check me-1"></i> SL-overzicht
                                </button>
                            </div>
                            @if (Model.PlotboekSettings?.GoogleDriveLastSyncedAt is { } lastSynced)
                            {
                            <small class="text-muted mt-2 d-block">
                                <i class="fas fa-clock me-1"></i>Google Drive laatste update:
                                <time data-utc="@lastSynced.ToString("o")">@lastSynced.ToString("dd-MM-yyyy HH:mm") UTC</time>
                            </small>
                            }
                        </div>

                        <!-- Edit Plotboek Form -->
                        @* id is what form-state.js hangs the unsaved-changes guard off — see hasUnsavedSettingsChanges(). *@
                        <form method="post" enctype="multipart/form-data" id="plotboek-settings-form">
                            <input type="hidden" name="Jaar" value="@Model.Jaar" />
                            <input type="hidden" name="Event" value="@Model.EventId" />
                            <input type="hidden" name="PaginaId" value="@Model.PaginaId" />
                            <input type="hidden" name="PlotboekVersion" value="@Model.PlotboekVersion" />
                            <input type="hidden" name="Action" value="savePlotboek" />
                            @if (!Model.IsAdmin)
                            {
                                <input type="hidden" name="EditablePlotboekIsVolledigKlaar" value="@(Model.PlotboekSettings?.IsVolledigKlaar == true ? "true" : "false")" />
                            }

                            @if (!string.IsNullOrEmpty(Model.ConcurrencyError))
                            {
                                <div class="alert alert-danger fade show" role="alert">
                                    <strong><i class="fas fa-exclamation-triangle"></i> Let op!</strong> @Model.ConcurrencyError
                                    <br /><small>Het formulier toont nu de huidige waarden.</small>
                                    @if (Model.AttemptedSettingsChanges.Count > 0)
                                    {
                                        <details class="mt-2">
                                            <summary><strong>Jouw niet-opgeslagen wijzigingen</strong></summary>
                                            <div class="mt-2">
                                                @foreach (var change in Model.AttemptedSettingsChanges)
                                                {
                                                    <div class="mb-2">
                                                        <strong>@change.Key:</strong>
                                                        @if (PlotboekModel.IsHtmlSettingsChangeLabel(change.Key))
                                                        {
                                                            <div class="mb-0 p-2 bg-body-tertiary border rounded small attempted-change-html">@Html.Raw(change.Value)</div>
                                                        }
                                                        else
                                                        {
                                                            <pre class="mb-0 p-2 bg-body-tertiary border rounded small" style="white-space: pre-wrap;">@change.Value</pre>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    }
                                </div>
                            }

                            @* Not a concurrency conflict: nothing was reloaded, so the form below still
                               holds everything the user typed and they only have to name the bijlage. *@
                            @if (!string.IsNullOrEmpty(Model.BijlagenValidationError))
                            {
                                <div class="alert alert-warning fade show" role="alert">
                                    <strong><i class="fas fa-exclamation-triangle"></i> Let op!</strong> @Model.BijlagenValidationError
                                    <br /><small>Je wijzigingen staan nog in het formulier hieronder.</small>
                                </div>
                            }

                            <h6 class="text-secondary mb-3">Plotboek Bewerken</h6>
                            @{
                                var nietKlarePaginas = Model.GetNietKlarePlotboekPaginaNames();
                                var plotboekVolledigKlaarDisabled = !Model.IsAdmin || (nietKlarePaginas.Count > 0 && Model.PlotboekSettings?.IsVolledigKlaar != true);
                            }
                            <div class="mb-3 p-3 border rounded @(Model.PlotboekSettings?.IsVolledigKlaar == true ? "bg-success bg-opacity-10 border-success" : "bg-body-tertiary")">
                                <div class="form-check form-switch">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           asp-for="EditablePlotboekIsVolledigKlaar"
                                           id="editable-plotboek-is-volledig-klaar"
                                           disabled="@plotboekVolledigKlaarDisabled">
                                    <label class="form-check-label fw-bold @(Model.PlotboekSettings?.IsVolledigKlaar == true ? "text-success" : "")" for="editable-plotboek-is-volledig-klaar">
                                        <i class="fas @(Model.PlotboekSettings?.IsVolledigKlaar == true ? "fa-check-circle" : "fa-circle") me-1"></i>Plotboek volledig klaar
                                    </label>
                                </div>
                                @if (!Model.IsAdmin)
                                {
                                    <small class="text-muted d-block mt-1">Alleen admins kunnen deze status aanpassen.</small>
                                }
                                else if (nietKlarePaginas.Count > 5)
                                {
                                    <div class="alert alert-warning py-2 mt-2 mb-0" role="alert">
                                        <div>Dit plotboek kan nog niet volledig klaar worden gezet. Er zijn nog <strong>@nietKlarePaginas.Count</strong> pagina's niet klaar.</div>
                                    </div>
                                }
                                else if (nietKlarePaginas.Count > 0)
                                {
                                    <div class="alert alert-warning py-2 mt-2 mb-0" role="alert">
                                        <div>Dit plotboek kan nog niet volledig klaar worden gezet. De volgende pagina's zijn nog niet klaar:</div>
                                        <ul class="mb-0 mt-1">
                                            @foreach (var paginaNaam in nietKlarePaginas)
                                            {
                                                <li>@paginaNaam</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted d-block mt-1">Zet dit aan wanneer het volledige plotboek gecontroleerd is en zichtbaar mag worden voor NPC's.</small>
                                }
                            </div>
                            <fieldset @(Model.IsPlotboekReadOnly ? "disabled" : "")>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="plotboek-titel" class="form-label fw-bold">Titel:</label>
                                    <input type="text"
                                           id="plotboek-titel"
                                           asp-for="EditablePlotboekTitel"
                                           class="form-control">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="VoorbladAfbeelding" class="form-label fw-bold">Voorblad Afbeelding:</label>
                                    @if (Model.HasVoorblad)
                                    {
                                        <div class="mb-2">
                                            <img src="@Url.Page("/Plotboek", "VoorbladAfbeelding", new { Jaar = Model.Jaar, Event = Model.EventId })"
                                                 alt="Voorblad" class="img-thumbnail" style="max-height: 200px;" />
                                        </div>
                                        <div class="form-check mb-2">
                                            <input type="checkbox" class="form-check-input" asp-for="VerwijderVoorblad" id="VerwijderVoorblad" />
                                            <label class="form-check-label text-danger" for="VerwijderVoorblad">
                                                <i class="fas fa-trash-alt me-1"></i>Huidige afbeelding verwijderen
                                            </label>
                                        </div>
                                    }
                                    <input type="file"
                                           asp-for="VoorbladAfbeelding"
                                           class="form-control"
                                           accept="image/*" />
                                    <small class="text-muted">Upload een afbeelding voor het voorblad van het plotboek (DOCX export).</small>
                                </div>
                            </div>

                            @if (!Model.IsEvergreen)
                            {
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label for="EditablePlotboekStartDatumString" class="form-label fw-bold">Start Datum:</label>
                                    <input type="date"
                                           asp-for="EditablePlotboekStartDatumString"
                                           class="form-control"
                                           onchange="toggleDagFields()">
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label for="EditablePlotboekEindDatumString" class="form-label fw-bold">Eind Datum:</label>
                                    <input type="date"
                                           asp-for="EditablePlotboekEindDatumString"
                                           class="form-control"
                                           onchange="toggleDagFields()">
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label for="EditablePlotboekStartDag" class="form-label fw-bold">Start Dag:</label>
                                    <select asp-for="EditablePlotboekStartDag"
                                            class="form-select">
                                        @foreach (var dag in Enum.GetValues<core.Enums.Dag>())
                                        {
                                            <option value="@dag" selected="@(Model.EditablePlotboekStartDag == dag)">@dag</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label for="EditablePlotboekEindDag" class="form-label fw-bold">Eind Dag:</label>
                                    <select asp-for="EditablePlotboekEindDag"
                                            class="form-select">
                                        @foreach (var dag in Enum.GetValues<core.Enums.Dag>())
                                        {
                                            <option value="@dag" selected="@(Model.EditablePlotboekEindDag == dag)">@dag</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="alert alert-info py-2 small" role="alert">
                                <i class="fas fa-info-circle me-1"></i>
                                Als Start Datum en Eind Datum zijn ingevuld, worden de Start Dag en Eind Dag automatisch bepaald.
                                Leeg de datums om de dagen handmatig te kunnen aanpassen.
                            </div>
                            }
                            else
                            {
                            <div class="alert alert-info py-2 small" role="alert">
                                <i class="fas fa-seedling me-1"></i>
                                Dit is het Evergreen plotboek. Encounters hierin zijn niet gebonden aan een specifiek evenement.
                                Voltooide encounters worden automatisch toegevoegd aan de export van reguliere plotboeken.
                            </div>
                            }

                            <div class="row">
                                <div class="col-12 mb-3">
                                    <label class="form-label fw-bold">Samenvatting Algemeen Plot:</label>
                                    <small class="form-text text-muted d-block mb-2">
                                        Optioneel. Algemene samenvatting van het overkoepelende plot voor dit plotboek.
                                    </small>
                                    @* data-target pairs the editor with its hidden input, the same convention the
                                       bijlage editors use, so form-state.js can keep the posted value in step with
                                       the editor while typing instead of only on submit. *@
                                    <input type="hidden" id="editable-samenvatting-algemeen-plot" asp-for="EditableSamenvattingAlgemeenPlot" />
                                    <div id="samenvatting-algemeen-plot-editor" data-target="editable-samenvatting-algemeen-plot">@Html.Raw(Model.EditableSamenvattingAlgemeenPlot)</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-8 mb-3">
                                    <label for="EditableGoogleDriveFolderUrl" class="form-label fw-bold">
                                        <i class="fab fa-google-drive me-1"></i>Google Drive Folder URL:
                                    </label>
                                    <input type="url"
                                           asp-for="EditableGoogleDriveFolderUrl"
                                           class="form-control"
                                           placeholder="https://drive.google.com/drive/folders/...">
                                    <small class="text-muted">
                                        Optioneel. De Google Drive folder waar het gegenereerde DOCX bestand naar wordt geüpload.
                                    </small>
                                </div>
                            </div>

                        @if (!Model.IsEvergreen)
                        {
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">
                                    <i class="fas fa-users me-1"></i>Verwacht aantal NPCs per dag:
                                </label>
                                <small class="form-text text-muted d-block mb-2">
                                    Optioneel. Vul in hoeveel NPCs beschikbaar zijn per dag.
                                    De NPC-totalen per tijdblok kleuren dan groen/geel/rood.
                                </small>
                                <div class="d-flex flex-wrap gap-3">
                                    @{ 
                                        var startDag = Model.PlotboekSettings?.StartDag ?? core.Enums.Dag.None;
                                        var eindDag  = Model.PlotboekSettings?.EindDag  ?? core.Enums.Dag.None;
                                        var dagVolgorde = new[] { core.Enums.Dag.Donderdag, core.Enums.Dag.Vrijdag, core.Enums.Dag.Zaterdag, core.Enums.Dag.Zondag };
                                        var zichtbareDagen = dagVolgorde
                                            .Where(d => startDag != core.Enums.Dag.None && eindDag != core.Enums.Dag.None
                                                        && (int)d >= (int)startDag && (int)d <= (int)eindDag)
                                            .ToList();
                                    }
                                    @foreach (var dag in zichtbareDagen)
                                    {
                                        var inputId = dag switch
                                        {
                                            core.Enums.Dag.Donderdag => "npcs-donderdag",
                                            core.Enums.Dag.Vrijdag => "npcs-vrijdag",
                                            core.Enums.Dag.Zaterdag => "npcs-zaterdag",
                                            core.Enums.Dag.Zondag => "npcs-zondag",
                                            _ => string.Empty,
                                        };
                                        if (!string.IsNullOrEmpty(inputId))
                                        {
                                            <div style="min-width: 120px;">
                                                <label for="@inputId" class="form-label">@dag</label>
                                                @if (dag == core.Enums.Dag.Donderdag)
                                                {
                                                    <input type="number" id="@inputId" asp-for="EditableNpcsDonderdag"
                                                           class="form-control" min="0" placeholder="—" />
                                                }
                                                else if (dag == core.Enums.Dag.Vrijdag)
                                                {
                                                    <input type="number" id="@inputId" asp-for="EditableNpcsVrijdag"
                                                           class="form-control" min="0" placeholder="—" />
                                                }
                                                else if (dag == core.Enums.Dag.Zaterdag)
                                                {
                                                    <input type="number" id="@inputId" asp-for="EditableNpcsZaterdag"
                                                           class="form-control" min="0" placeholder="—" />
                                                }
                                                else if (dag == core.Enums.Dag.Zondag)
                                                {
                                                    <input type="number" id="@inputId" asp-for="EditableNpcsZondag"
                                                           class="form-control" min="0" placeholder="—" />
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                                @if (zichtbareDagen.Count == 0)
                                {
                                    <small class="text-muted fst-italic">
                                        Stel eerst de start- en einddagen in om NPC-aantallen per dag te kunnen invoeren.
                                    </small>
                                }
                            </div>
                        </div>
                        }

                            <partial name="Shared/Plotboek/_PlotboekBijlagen" model="Model" />
                            </fieldset>
                            @if (!Model.IsPlotboekReadOnly)
                            {
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i> Plotboek Opslaan
                                </button>
                            }
                        </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
