@using System.Globalization
@model PlotboekModel

@*
    Feedback on a plot: the HSL raises points, whoever writes the plot responds, the HSL signs them off,
    reopens or withdraws them.

    Deliberately rendered OUTSIDE #pagina-details-form and outside the #pagina-fields fieldset, each
    action on its own little form. Responding has to keep working while the plot itself is content-locked
    (a "volledig klaar" pagina, or a closed plotboek) — otherwise an SL could never unblock their own plot.

    Text is plain, not Quill: these are short internal remarks. The .feedback-tekst class keeps the line
    breaks (white-space: pre-wrap) and Razor encodes the value, so no @@Html.Raw here.
*@

@{
    var openFeedback = Model.OpenFeedback;
    var beantwoordeFeedback = Model.BeantwoordeFeedback;
    var afgehandeldeFeedback = Model.AfgehandeldeFeedback;
    var heeftFeedback = Model.SelectedPaginaFeedback.Count > 0;

    // A blocking point must not need looking for: open feedback springs the section open, while every
    // other section on the detail panel starts collapsed.
    var standaardOpen = openFeedback.Count > 0;

    var samenvattingDelen = new List<string>();
    if (openFeedback.Count > 0)
    {
        samenvattingDelen.Add(string.Format(CultureInfo.CurrentCulture, PaginaUi.FeedbackAantalOpen, openFeedback.Count));
    }
    if (beantwoordeFeedback.Count > 0)
    {
        samenvattingDelen.Add(string.Format(CultureInfo.CurrentCulture, PaginaUi.FeedbackAantalBeantwoord, beantwoordeFeedback.Count));
    }
    if (afgehandeldeFeedback.Count > 0)
    {
        samenvattingDelen.Add(string.Format(CultureInfo.CurrentCulture, PaginaUi.FeedbackAantalAfgehandeld, afgehandeldeFeedback.Count));
    }
}

@if (Model.CanSeeFeedback && (heeftFeedback || Model.CanManageFeedback))
{
    <div class="detail-section">
        <div class="detail-section-header"
             role="button"
             data-bs-toggle="collapse"
             data-bs-target="#section-feedback"
             aria-expanded="@(standaardOpen ? "true" : "false")"
             aria-controls="section-feedback">
            <div class="d-flex justify-content-between align-items-center">
                <span class="detail-section-label">
                    <i class="fas fa-comment-dots me-1 @(openFeedback.Count > 0 ? "text-danger" : "")"></i>@PaginaUi.FeedbackSectie
                    @if (openFeedback.Count > 0)
                    {
                        <i class="fas fa-exclamation-triangle text-danger ms-1"></i>
                        <small class="text-danger ms-1">@PaginaUi.FeedbackBlokkeertVolledigKlaar</small>
                    }
                </span>
                <i class="fas fa-chevron-down detail-section-chevron"></i>
            </div>
            <div class="detail-section-summary mt-1">
                @if (samenvattingDelen.Count > 0)
                {
                    @string.Join(" · ", samenvattingDelen)
                }
                else
                {
                    <span class="text-muted fst-italic">@PaginaUi.GeenFeedback</span>
                }
            </div>
        </div>
        <div class="collapse @(standaardOpen ? "show" : "")" id="section-feedback">
            <div class="detail-section-body">

                @if (!heeftFeedback)
                {
                    <p class="text-muted fst-italic mb-3">@PaginaUi.FeedbackNogGeen</p>
                }

                @foreach (var punt in openFeedback.Concat(beantwoordeFeedback))
                {
                    <partial name="Shared/Plotboek/_PlotboekPaginaFeedbackKaart" model="new PlotboekModel.FeedbackKaart { Page = Model, Punt = punt }" />
                }

                @if (afgehandeldeFeedback.Count > 0)
                {
                    <details class="feedback-afgehandeld mb-3">
                        <summary class="text-muted small">
                            <i class="fas fa-check me-1"></i>@string.Format(CultureInfo.CurrentCulture, PaginaUi.FeedbackAfgehandeldeKop, afgehandeldeFeedback.Count)
                        </summary>
                        <div class="mt-2">
                            @foreach (var punt in afgehandeldeFeedback)
                            {
                                <partial name="Shared/Plotboek/_PlotboekPaginaFeedbackKaart" model="new PlotboekModel.FeedbackKaart { Page = Model, Punt = punt }" />
                            }
                        </div>
                    </details>
                }

                @if (Model.CanManageFeedback)
                {
                    <form method="post" class="feedback-toevoegen border-top pt-3">
                        <input type="hidden" name="Jaar" value="@Model.Jaar" />
                        <input type="hidden" name="Event" value="@Model.EventId" />
                        <input type="hidden" name="PaginaId" value="@Model.PaginaId" />
                        <label for="nieuwe-feedback-tekst" class="form-label fw-bold small">@PaginaUi.FeedbackToevoegenLabel</label>
                        <textarea id="nieuwe-feedback-tekst"
                                  name="NieuweFeedbackTekst"
                                  class="form-control form-control-sm"
                                  rows="3"
                                  placeholder="@PaginaUi.FeedbackToevoegenPlaceholder"></textarea>
                        <small class="form-text text-muted d-block mb-2">
                            @PaginaUi.FeedbackToevoegenUitleg
                        </small>
                        <button type="submit" name="Action" value="addFeedback" class="btn btn-primary btn-sm">
                            <i class="fas fa-comment-medical me-1"></i>@PaginaUi.FeedbackToevoegen
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
}
