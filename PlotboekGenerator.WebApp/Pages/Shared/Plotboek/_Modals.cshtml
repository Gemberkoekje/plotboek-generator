@* SL Overzicht Modal — encounters per SL (hoofdverantwoordelijk + optioneel bijrol/extra SL) *@
@{
    var slStarttijdOrder = Model.AvailableStarttijdConfigs
        .Where(c => !c.IsNone)
        .OrderBy(c => c.Order)
        .Select((c, i) => new { c.Id, Idx = i })
        .ToDictionary(x => x.Id, x => x.Idx);

    Func<string, int> slStarttijdSort = id => id != null && slStarttijdOrder.TryGetValue(id, out var o) ? o : int.MaxValue;

    // Plots where an SL is the main responsible, keyed by SL id.
    var slPrimary = Model.PlotboekPaginas
        .Where(p => !string.IsNullOrEmpty(p.VerantwoordelijkeSlId))
        .GroupBy(p => p.VerantwoordelijkeSlId!)
        .ToDictionary(g => g.Key, g => g.ToList());

    // Plots where an SL is an extra (secondary) SL, keyed by SL id.
    var slSecondary = Model.PlotboekPaginas
        .SelectMany(p => (p.ExtraSlIds ?? []).Where(id => !string.IsNullOrEmpty(id)).Select(id => new { Id = id, Pagina = p }))
        .GroupBy(x => x.Id, x => x.Pagina)
        .ToDictionary(g => g.Key, g => g.ToList());

    // Resolve a display name for an SL id (prefer the current user list, fall back to names carried on paginas).
    var slNameById = new Dictionary<string, string>(StringComparer.Ordinal);
    foreach (var p in Model.PlotboekPaginas)
    {
        if (!string.IsNullOrEmpty(p.VerantwoordelijkeSlId) && !string.IsNullOrEmpty(p.VerantwoordelijkeSlName))
        {
            slNameById[p.VerantwoordelijkeSlId] = p.VerantwoordelijkeSlName!;
        }
        var eIds = p.ExtraSlIds ?? [];
        var eNames = p.ExtraSlNames ?? [];
        for (var i = 0; i < eIds.Count; i++)
        {
            if (!string.IsNullOrEmpty(eIds[i]) && i < eNames.Count && !string.IsNullOrEmpty(eNames[i]))
            {
                slNameById[eIds[i]] = eNames[i];
            }
        }
    }

    Func<string, string> slName = id =>
        Model.AvailableSls.FirstOrDefault(s => s.Id == id)?.DisplayName
        ?? (slNameById.TryGetValue(id, out var n) ? n : id);

    var slGroups = slPrimary.Keys.Concat(slSecondary.Keys).Distinct()
        .Select(id => new
        {
            SlId = id,
            SlName = slName(id),
            Primary = (slPrimary.GetValueOrDefault(id) ?? [])
                .OrderBy(p => p.Dag).ThenBy(p => slStarttijdSort(p.StarttijdId)).ThenBy(p => p.Order).ToList(),
            Secondary = (slSecondary.GetValueOrDefault(id) ?? [])
                // A plot where the SL is both main and extra is only listed as primary.
                .Where(p => !(slPrimary.TryGetValue(id, out var mains) && mains.Contains(p)))
                .OrderBy(p => p.Dag).ThenBy(p => slStarttijdSort(p.StarttijdId)).ThenBy(p => p.Order).ToList(),
        })
        .OrderBy(x => x.SlName, StringComparer.OrdinalIgnoreCase)
        .ToList();

    var slDefaultId = slGroups.Any(x => x.SlId == Model.CurrentUserSlId)
        ? Model.CurrentUserSlId
        : slGroups.FirstOrDefault()?.SlId;
}

<style>
    #slOverzichtModal.hide-bijrol .sl-secondary-section { display: none; }
    #slOverzichtModal .sl-only-secondary-note { display: none; }
    #slOverzichtModal.hide-bijrol .sl-only-secondary-note { display: block; }
</style>

<div class="modal fade" id="slOverzichtModal" tabindex="-1" aria-labelledby="slOverzichtModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-body-tertiary">
                <h5 class="modal-title" id="slOverzichtModalLabel"><i class="fas fa-user-check me-2"></i>@PlotboekUi.EncountersPerSl</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@PlotboekUi.Sluiten"></button>
            </div>
            <div class="modal-body">
                @if (slGroups.Count == 0)
                {
                    <p class="text-muted mb-0">@PlotboekUi.GeenEncountersMetSl</p>
                }
                else
                {
                    <div class="mb-3">
                        <label for="sl-overzicht-select" class="form-label fw-bold">@PlotboekUi.Spelleider</label>
                        <select id="sl-overzicht-select" class="form-select" onchange="showSlOverzichtBlock(this.value)">
                            @foreach (var grp in slGroups)
                            {
                                var countLabel = grp.Secondary.Count > 0 ? $"{grp.Primary.Count} +{grp.Secondary.Count}" : $"{grp.Primary.Count}";
                                <option value="@grp.SlId" selected="@(grp.SlId == slDefaultId)">@grp.SlName (@countLabel)</option>
                            }
                        </select>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="sl-overzicht-bijrol" checked onchange="toggleSlBijrol()">
                            <label class="form-check-label" for="sl-overzicht-bijrol">@PlotboekUi.ToonBijrol</label>
                        </div>
                    </div>

                    @foreach (var grp in slGroups)
                    {
                        var showSectionLabels = grp.Primary.Count > 0 && grp.Secondary.Count > 0;
                        var sections = new[]
                        {
                            (Label: PlotboekUi.Hoofdverantwoordelijk, Css: string.Empty, Paginas: grp.Primary),
                            (Label: PlotboekUi.OndersteunendBijrol, Css: "sl-secondary-section", Paginas: grp.Secondary),
                        };
                        <div class="sl-overzicht-block" data-sl-block="@grp.SlId" style="display: @(grp.SlId == slDefaultId ? "block" : "none");">
                            @if (grp.Primary.Count == 0)
                            {
                                <p class="text-muted sl-only-secondary-note mb-0">@Html.Raw(PlotboekUi.NergensHoofdverantwoordelijkHtml)</p>
                            }
                            @foreach (var sec in sections.Where(s => s.Paginas.Count > 0))
                            {
                                <div class="@sec.Css">
                                    @if (showSectionLabels)
                                    {
                                        <div class="fw-bold text-secondary small mt-3 mb-1"><i class="fas fa-user-tag me-1"></i>@sec.Label</div>
                                    }
                                    @foreach (var dayGroup in sec.Paginas.GroupBy(p => p.Dag))
                                    {
                                        <h6 class="text-secondary mt-2">@(dayGroup.Key == core.Enums.Dag.None ? PlotboekUi.NogNietIngedeeld : dayGroup.Key.Naam())</h6>
                                        <div class="list-group mb-2">
                                            @foreach (var p in dayGroup)
                                            {
                                                var tijd = p.StarttijdId == "None" ? string.Empty : Model.AvailableStarttijdConfigs.GetDisplayName(p.StarttijdId);
                                                <a href="@Url.Page("/Plotboek", new { Jaar = Model.Jaar, Event = Model.EventId, PaginaId = p.Id })"
                                                   class="list-group-item list-group-item-action d-flex align-items-center">
                                                    @if (p.IsVolledigKlaar)
                                                    {
                                                        <i class="fas fa-check-circle text-success me-2" title="@PlotboekUi.VolledigKlaar"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-exclamation-triangle text-warning me-2" title="@PlotboekUi.NogNietVolledigKlaar"></i>
                                                    }
                                                    @if (!string.IsNullOrEmpty(p.DomainShorthand))
                                                    {
                                                        var disp = !string.IsNullOrEmpty(p.PlotlijnNummer) ? $"{p.DomainShorthand} {p.PlotlijnNummer}" : p.DomainShorthand;
                                                        <span class="badge bg-secondary me-2">@disp</span>
                                                    }
                                                    <span class="flex-grow-1">@p.Title</span>
                                                    @if (!string.IsNullOrEmpty(tijd))
                                                    {
                                                        <small class="text-muted me-2 text-nowrap">@tijd</small>
                                                    }
                                                    <small class="text-muted text-nowrap" title="@PlotboekUi.AantalNpcs">@p.AantalNpcs.ToCountDisplayString()</small>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <div class="modal-footer bg-body-tertiary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>@PlotboekUi.Sluiten</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showSlOverzichtBlock(slId) {
        document.querySelectorAll('#slOverzichtModal .sl-overzicht-block').forEach(function (block) {
            block.style.display = block.getAttribute('data-sl-block') === slId ? 'block' : 'none';
        });
    }

    function toggleSlBijrol() {
        var modal = document.getElementById('slOverzichtModal');
        var toggle = document.getElementById('sl-overzicht-bijrol');
        if (!modal || !toggle) { return; }
        modal.classList.toggle('hide-bijrol', !toggle.checked);
        localStorage.setItem('plotboek.showSlBijrol', toggle.checked ? 'true' : 'false');
    }

    (function () {
        var modal = document.getElementById('slOverzichtModal');
        var toggle = document.getElementById('sl-overzicht-bijrol');
        if (!modal || !toggle) { return; }
        var stored = localStorage.getItem('plotboek.showSlBijrol');
        var show = stored === null ? true : stored === 'true';
        toggle.checked = show;
        modal.classList.toggle('hide-bijrol', !show);
    })();
</script>
