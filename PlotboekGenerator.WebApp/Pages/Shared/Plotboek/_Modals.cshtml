@* Pagina Actions Modal *@
@if (Model.SelectedPlotboekPagina != null && !Model.IsPlotboekReadOnly)
{
    <div class="modal fade" id="paginaActionsModal" tabindex="-1" aria-labelledby="paginaActionsModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="paginaActionsModalLabel"><i class="fas fa-ellipsis-h me-2"></i>@PlotboekUi.PaginaActies</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@PlotboekUi.Sluiten"></button>
                </div>
                <div class="modal-body">
                    <form method="post" class="mb-3">
                        <input type="hidden" name="Jaar" value="@Model.Jaar" />
                        <input type="hidden" name="Event" value="@Model.EventId" />
                        <input type="hidden" name="PaginaId" value="@Model.PaginaId" />
                        <input type="hidden" name="Action" value="movePagina" />

                        @{
                            var movablePlotboeken = Model.AvailablePlotboeken
                                .Where(p => !string.Equals(p.EventId, "Evergreen", StringComparison.Ordinal))
                                .ToList();
                            var currentPlotboekIndex = movablePlotboeken.FindIndex(p => p.Id == Model.PlotboekId);
                            var suggestedMovePlotboekId = currentPlotboekIndex >= 0 && currentPlotboekIndex + 1 < movablePlotboeken.Count
                                ? movablePlotboeken[currentPlotboekIndex + 1].Id
                                : PlotboekId.Empty;
                        }

                        <label for="move-to-plotboek" class="form-label fw-bold">@PlotboekUi.VerplaatsNaarPlotboek</label>
                        <select id="move-to-plotboek" name="MoveToPlotboekId" class="form-select mb-2">
                            <option value="">@PlotboekUi.VerplaatsNaarPlotboekKiezen</option>
                            @foreach (var plotboek in movablePlotboeken)
                            {
                                <option value="@plotboek.Id"
                                        disabled="@(plotboek.Id == Model.PlotboekId)"
                                        selected="@(plotboek.Id == suggestedMovePlotboekId)">
                                    @plotboek.DisplayName
                                </option>
                            }
                            @{
                                var evergreenPlotboek = Model.AvailablePlotboeken.FirstOrDefault(p => string.Equals(p.EventId, "Evergreen", StringComparison.Ordinal));
                            }
                            @if (evergreenPlotboek != null)
                            {
                                <option disabled>──────────</option>
                                <option value="@evergreenPlotboek.Id" disabled="@(evergreenPlotboek.Id == Model.PlotboekId)">
                                    🌿 @evergreenPlotboek.DisplayName
                                </option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-warning btn-sm">
                            <i class="fas fa-arrow-right me-1"></i>@PlotboekUi.VerplaatsPagina
                        </button>
                    </form>

                    <hr />

                    <form method="post" class="mb-3">
                        <input type="hidden" name="Jaar" value="@Model.Jaar" />
                        <input type="hidden" name="Event" value="@Model.EventId" />
                        <input type="hidden" name="PaginaId" value="@Model.PaginaId" />
                        <input type="hidden" name="Action" value="duplicatePagina" />
                        <label class="form-label fw-bold d-block mb-1">@PlotboekUi.Dupliceren</label>
                        <small class="text-muted d-block mb-2">@PlotboekUi.DuplicerenUitleg</small>
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-copy me-1"></i>@PlotboekUi.DupliceerPagina
                        </button>
                    </form>

                    <hr />

                    <form method="post">
                        <input type="hidden" name="Jaar" value="@Model.Jaar" />
                        <input type="hidden" name="Event" value="@Model.EventId" />
                        <input type="hidden" name="PaginaId" value="@Model.PaginaId" />
                        <input type="hidden" name="Action" value="deletePagina" />
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-trash me-1"></i>@PlotboekUi.Verwijderen
                        </button>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@PlotboekUi.Sluiten</button>
                </div>
            </div>
        </div>
    </div>
}

