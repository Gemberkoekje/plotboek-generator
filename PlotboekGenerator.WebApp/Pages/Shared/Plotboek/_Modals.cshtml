                        </div>
                    }
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <a href="@Url.Page("/Plotboek", new { Jaar = Model.Jaar, Event = Model.EventId, PaginaId = Model.PaginaId })" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i>@PlotboekUi.Sluiten
                    </a>
                </div>
            </div>
        </div>
    </div>
