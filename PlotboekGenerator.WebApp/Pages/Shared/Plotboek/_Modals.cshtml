@model PlotboekModel
@using System.Globalization
@inject PlotboekGenerator.WebApp.TerreinKaart TerreinKaart

@{
    var rawDebugStyle = "display: none; white-space: pre-wrap; word-break: break-word;";
}

@* Hidden Reorder Form *@
@if (!Model.IsPlotboekReadOnly)
{
<form id="reorderForm" method="post" style="display: none;">
    <input type="hidden" name="Jaar" value="@Model.Jaar" />
    <input type="hidden" name="Event" value="@Model.EventId" />
    <input type="hidden" name="PaginaId" value="@Model.PaginaId" />
    <input type="hidden" name="Action" value="reorder" />
    <input type="hidden" id="ReorderPaginaId" name="ReorderPaginaId" />
    <input type="hidden" id="ReorderDag" name="ReorderDag" />
    <input type="hidden" id="ReorderStarttijd" name="ReorderStarttijd" />
    <input type="hidden" id="ReorderNewOrder" name="ReorderNewOrder" />
</form>
}

@* Plotboek Audit Trail Modal *@
@if (Model.ShowPlotboekAuditTrail)
{
    <div class="modal fade show" id="plotboekAuditModal" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-body-tertiary">
                    <h5 class="modal-title"><i class="fas fa-history me-2"></i>@PlotboekUi.PlotboekWijzigingenTitel</h5>
                    <a href="@Url.Page("/Plotboek", new { Jaar = Model.Jaar, Event = Model.EventId, PaginaId = Model.PaginaId })" class="btn-close" aria-label="@PlotboekUi.Sluiten"></a>
                </div>
                <div class="modal-body p-0">
                    @if (Model.PlotboekAuditTrail.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="sticky-top">
                                    <tr>
                                        <th>@PlotboekUi.AuditWanneer</th>
                                        <th>@PlotboekUi.AuditWie</th>
                                        <th>@PlotboekUi.AuditWat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in Model.PlotboekAuditTrail)
                                    {
                                        <tr>
                                            <td class="text-muted small text-nowrap" data-utc="@entry.When.ToString("o")">@entry.When.ToString("dd-MM-yyyy HH:mm")</td>
                                            <td class="text-nowrap">@entry.Who</td>
                                            <td>
                                                @Html.Raw(entry.What)
                                                @if (!string.IsNullOrEmpty(entry.Details))
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1 py-0 px-1 audit-details-toggle" title="@PlotboekUi.AuditDetailsTonen">
                                                        <i class="fas fa-chevron-down fa-xs"></i>
                                                    </button>
                                                    <div class="audit-details mt-1 p-2 bg-body-tertiary border rounded small" style="display: none;">
                                                        <div>@Html.Raw(entry.Details)</div>
                                                        @if (!string.IsNullOrEmpty(entry.DebugDetails))
                                                        {
                                                            <button type="button" class="btn btn-link btn-sm px-0 mt-2 audit-debug-toggle">@PlotboekUi.AuditDebugTonen</button>
                                                            <pre class="audit-debug-details mt-2 mb-0 p-2 bg-body border rounded small" style="@rawDebugStyle">@entry.DebugDetails</pre>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center">
                            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">@PlotboekUi.GeenWijzigingen</p>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-body-tertiary">
                    <a href="@Url.Page("/Plotboek", new { Jaar = Model.Jaar, Event = Model.EventId, PaginaId = Model.PaginaId })" class="btn btn-secondary">
                        <i class="fas fa-times me-1"></i>@PlotboekUi.Sluiten
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

