@* Terreinkaart Modal — opened from the "?" next to "Locatie Encounter" in the pagina details. *@
@if (TerreinKaart.IsIngesteld)
{
    <div class="modal fade" id="terreinKaartModal" tabindex="-1" aria-labelledby="terreinKaartModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="terreinKaartModalLabel">
                        <i class="fas fa-map me-2"></i>@TerreinKaart.Titel
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@PlotboekUi.Sluiten"></button>
                </div>
                <div class="modal-body text-center">
                    @* A white backing in both themes (.kaart-papier): a map is usually black line art. *@
                    <img src="@Url.Content(TerreinKaart.Url)"
                         asp-append-version="true"
                         class="img-fluid kaart-papier rounded"
                         alt="@TerreinKaart.AltTekst" />
                </div>
                <div class="modal-footer justify-content-between">
                    <small class="text-muted">@TerreinKaart.Bijschrift</small>
                    <a href="@Url.Content(TerreinKaart.Url)" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-up-right-and-down-left-from-center me-1"></i>@PlotboekUi.KaartVolledigFormaat
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@* New Pagina Modal *@
@if (!Model.IsPlotboekReadOnly)
{
<div class="modal fade" id="newPaginaModal" tabindex="-1" aria-labelledby="newPaginaModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                <input type="hidden" name="Jaar" value="@Model.Jaar" />
                <input type="hidden" name="Event" value="@Model.EventId" />
                <input type="hidden" name="Action" value="newPagina" />
                <div class="modal-header">
                    <h5 class="modal-title" id="newPaginaModalLabel"><i class="fas fa-plus me-2"></i>@PlotboekUi.NieuwePagina</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@PlotboekUi.Sluiten"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newPaginaTitel" class="form-label fw-bold">@PlotboekUi.TitelLabel</label>
                        <input type="text"
                               id="newPaginaTitel"
                               name="NewPaginaTitel"
                               class="form-control"
                               required
                               autofocus>
