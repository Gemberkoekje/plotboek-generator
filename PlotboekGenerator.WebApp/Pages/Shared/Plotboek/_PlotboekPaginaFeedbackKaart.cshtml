@model PlotboekModel.FeedbackKaart

@*
    One feedback point. Each action posts its own little form with the point's id, so several cards on
    one plot never interfere. The Action value on the submit button drives the dispatch in OnPost.
*@

@{
    var vm = Model.Page;
    var punt = Model.Punt;
    var isOpen = punt.Status == FeedbackStatus.Open;
    var isBeantwoord = punt.Status == FeedbackStatus.Beantwoord;
    var isAfgehandeld = punt.Status == FeedbackStatus.Afgehandeld;
    var puntId = punt.Id.ToString();
}

<div class="feedback-kaart border rounded p-2 mb-2 @(isOpen ? "feedback-kaart-open" : "")">
    <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="small text-muted">
            van <strong>@vm.GetFeedbackAuteurNaam(punt.GegevenDoor)</strong>
            &middot; <span data-utc="@PlotboekModel.ToUtcAttribute(punt.GegevenOp)">@punt.GegevenOp.ToString("dd-MM-yyyy HH:mm")</span>
        </div>
        @if (isOpen)
        {
            <span class="badge bg-danger text-nowrap">Open</span>
        }
        else if (isAfgehandeld)
        {
            <span class="badge bg-success text-nowrap">Afgehandeld</span>
        }
        else
        {
            <span class="badge text-bg-info text-nowrap">Beantwoord</span>
        }
    </div>

    <div class="feedback-tekst mt-1">@punt.Tekst</div>

    @if (punt.HeeftReactie)
    {
        <div class="feedback-reactie mt-2 ps-2">
            <div class="small text-muted">
                reactie van <strong>@vm.GetFeedbackAuteurNaam(punt.ReactieDoor)</strong>
                @if (punt.ReactieOp != default)
                {
                    <text>&middot; <span data-utc="@PlotboekModel.ToUtcAttribute(punt.ReactieOp)">@punt.ReactieOp.ToString("dd-MM-yyyy HH:mm")</span></text>
                }
            </div>
            <div class="feedback-tekst">@punt.Reactie</div>
        </div>
    }

    @if (isOpen && vm.CanRespondToFeedback)
    {
        <form method="post" class="mt-2">
            <input type="hidden" name="Jaar" value="@vm.Jaar" />
            <input type="hidden" name="Event" value="@vm.EventId" />
            <input type="hidden" name="PaginaId" value="@vm.PaginaId" />
            <input type="hidden" name="SelectedFeedbackId" value="@puntId" />
            <label for="feedback-reactie-@puntId" class="visually-hidden">Reactie op deze feedback</label>
            <textarea id="feedback-reactie-@puntId"
                      name="FeedbackReactie"
                      class="form-control form-control-sm"
                      rows="2"
                      placeholder="Wat heb je ermee gedaan?"></textarea>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="submit" name="Action" value="answerFeedback" class="btn btn-primary btn-sm">
                    <i class="fas fa-reply me-1"></i>Reageren
                </button>
                <button type="submit" name="Action" value="seenFeedback" class="btn btn-outline-secondary btn-sm"
                        title="Deblokkeert het plot zonder dat je iets hoeft te typen">
                    <i class="fas fa-eye me-1"></i>Gezien, geen actie
                </button>
            </div>
        </form>
    }

    @if (vm.CanManageFeedback)
    {
        <form method="post" class="mt-2 d-flex flex-wrap align-items-center gap-2">
            <input type="hidden" name="Jaar" value="@vm.Jaar" />
            <input type="hidden" name="Event" value="@vm.EventId" />
            <input type="hidden" name="PaginaId" value="@vm.PaginaId" />
            <input type="hidden" name="SelectedFeedbackId" value="@puntId" />

            @if (!isOpen)
            {
                <label for="feedback-reden-@puntId" class="visually-hidden">Reden voor heropenen</label>
                <input type="text"
                       id="feedback-reden-@puntId"
                       name="FeedbackHeropenReden"
                       class="form-control form-control-sm feedback-reden"
                       placeholder="Reden voor heropenen (optioneel)" />
            }

            @if (isBeantwoord)
            {
                <button type="submit" name="Action" value="resolveFeedback" class="btn btn-success btn-sm">
                    <i class="fas fa-check me-1"></i>Afhandelen
                </button>
            }

            @if (!isOpen)
            {
                <button type="submit" name="Action" value="reopenFeedback" class="btn btn-outline-warning btn-sm">
                    <i class="fas fa-rotate-left me-1"></i>Heropenen
                </button>
            }

            <button type="submit" name="Action" value="deleteFeedback" class="btn btn-outline-danger btn-sm ms-auto"
                    onclick="return confirm('Dit feedbackpunt intrekken? De reactie verdwijnt mee uit het overzicht.');">
                <i class="fas fa-trash me-1"></i>Intrekken
            </button>
        </form>
    }
</div>
