@model AdminModel
@using System.Globalization

<!-- World Name Management Section -->
<div class="card mb-4">
    <div class="card-header text-bg-warning">
        <h5 class="mb-0">
            <i class="fas fa-globe-americas"></i> @AdminUi.SectieWerelden
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">
            @AdminUi.WereldenUitleg
        </p>

        <!-- Add/Edit World Name Form -->
        <form method="post" class="mb-4">
            <input type="hidden" name="Action" value="saveWorldName" />
            <input type="hidden" name="Section" value="werelden" />
            <input type="hidden" name="EditWorldNameId" id="editWorldNameId" value="" />
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="editWorldNameNaam" class="form-label">@AdminUi.WereldLabel</label>
                    <input type="text"
                           class="form-control"
                           id="editWorldNameNaam"
                           name="EditWorldNameNaam"
                           required />
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-warning" id="saveWorldNameBtn">
                        <i class="fas fa-plus"></i> @AdminUi.WereldToevoegenButton
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="cancelEditWorldNameBtn" style="display: none;" onclick="cancelEditWorldName()">
                        <i class="fas fa-times"></i> @AdminUi.AnnulerenButton
                    </button>
                </div>
            </div>
        </form>

        <!-- World Names List -->
        @if (Model.WorldNames.Count > 0)
        {
            <p class="text-muted small mb-2">@string.Format(CultureInfo.CurrentCulture, Model.WorldNames.Count == 1 ? AdminUi.WereldenAantalOne : AdminUi.WereldenAantalMany, Model.WorldNames.Count)</p>
            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                <table class="table table-hover table-sm">
                    <thead class="sticky-top bg-body-tertiary">
                        <tr>
                            <th>@AdminUi.WereldLabel</th>
                            <th style="width: 150px;">@AdminUi.KolomActies</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var world in Model.WorldNames)
                        {
                            <tr>
                                <td>@world.Naam</td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary me-1"
                                            onclick="editWorldName('@world.Id', '@world.Naam')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form method="post" style="display: inline;">
                                        <input type="hidden" name="Action" value="deleteWorldName" />
                                        <input type="hidden" name="Section" value="werelden" />
                                        <input type="hidden" name="DeleteWorldNameId" value="@world.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                data-confirm="@string.Format(CultureInfo.CurrentCulture, AdminUi.WereldVerwijderenConfirm, world.Naam)"
                                                onclick="return confirm(this.dataset.confirm);">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> @AdminUi.GeenWerelden
            </div>
        }
    </div>
</div>
