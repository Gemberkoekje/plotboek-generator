@model AdminModel
@using System.Globalization

<!-- Filter Section -->
<div class="row mb-4">
    <div class="col-md-8">
        <form method="get" class="input-group">
            <input type="hidden" name="Section" value="users" />
            <input type="text"
                   name="Filter"
                   class="form-control"
                   placeholder="@AdminUi.FilterPlaceholder"
                   value="@Model.Filter" />
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i> @AdminUi.SearchButton
            </button>
            @if (!string.IsNullOrEmpty(Model.Filter))
            {
                <a href="@Url.Page("/Admin", new { Section = "users" })" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i> @AdminUi.ClearButton
                </a>
            }
        </form>
    </div>
</div>

<!-- Create Dummy SL Section -->
<div class="card mb-4">
    <div class="card-header text-bg-info">
        <h5 class="mb-0">
            <i class="fas fa-user-plus"></i> @AdminUi.DummySlAanmaken
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">
            @AdminUi.DummySlUitleg
        </p>
        <form method="post" class="row g-3 align-items-end">
            <input type="hidden" name="Action" value="createDummySl" />
            <input type="hidden" name="Section" value="users" />
            <div class="col-md-8">
                <label for="newDummySlUserName" class="form-label">@AdminUi.UsernameLabel</label>
                <input type="text" class="form-control" id="newDummySlUserName" name="NewDummySlUserName" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-info w-100">
                    <i class="fas fa-plus"></i> @AdminUi.DummySlAanmaken
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Link Accounts Section -->
<div class="card mb-4">
    <div class="card-header text-bg-warning">
        <h5 class="mb-0">
            <i class="fas fa-link"></i> @AdminUi.LinkAccountsKop
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">
            @AdminUi.LinkAccountsUitleg
        </p>
        <form method="post" class="row g-3 align-items-end">
            <input type="hidden" name="Action" value="linkAccounts" />
            <input type="hidden" name="Section" value="users" />
            <div class="col-md-5">
                <label for="sourceUserId" class="form-label">@AdminUi.SourceUserLabel</label>
                <select class="form-select" id="sourceUserId" name="SourceUserId" required>
                    <option value="">@AdminUi.SourceUserKiezen</option>
                    @foreach (var user in Model.AllUsers.OrderBy(u => u.UserName))
                    {
                        <option value="@user.Id">@string.Format(CultureInfo.CurrentCulture, user.IsDummy ? AdminUi.UserOptieDummy : AdminUi.UserOptie, user.UserName, user.Email, user.DisplayLogins)</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label for="targetUserId" class="form-label">@AdminUi.TargetUserLabel</label>
                <select class="form-select" id="targetUserId" name="TargetUserId" required>
                    <option value="">@AdminUi.TargetUserKiezen</option>
                    @foreach (var user in Model.AllUsers.OrderBy(u => u.UserName))
                    {
                        <option value="@user.Id">@string.Format(CultureInfo.CurrentCulture, user.IsDummy ? AdminUi.UserOptieDummy : AdminUi.UserOptie, user.UserName, user.Email, user.DisplayLogins)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-warning w-100" data-confirm="@AdminUi.MergeConfirm" onclick="return confirm(this.dataset.confirm);">
                    <i class="fas fa-compress-arrows-alt"></i> @AdminUi.MergeButton
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Users Grouped by Role -->
@{
    var roleSortOrder = new Dictionary<string, int>
    {
        ["Admin"] = 0,
        ["User"] = 1,
        ["Reader"] = 2,
        ["NPC"] = 3,
        ["Guest"] = 4
    };
    int GetRolePriority(string role) => roleSortOrder.GetValueOrDefault(role, 5);
}
@foreach (var roleGroup in Model.UsersByRole.OrderBy(r => GetRolePriority(r.Key)))
{
    <div class="card mb-4">
        <div class="card-header text-bg-primary">
            <h5 class="mb-0">
                <i class="fas fa-user-tag"></i> @roleGroup.Key
                <span class="badge pb-badge-neutral ms-2">@roleGroup.Value.Count</span>
            </h5>
        </div>
        <div class="card-body">
            @if (roleGroup.Value.Count == 0)
            {
                <p class="text-muted">@AdminUi.GeenUsersInRol</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>@AdminUi.UsernameLabel</th>
                                <th>@AdminUi.KolomEmail</th>
                                <th>@AdminUi.KolomDomain</th>
                                <th>@AdminUi.ExternalLogins</th>
                                <th>@AdminUi.KolomCreated</th>
                                <th>@AdminUi.KolomActions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in roleGroup.Value.OrderBy(u => u.UserName))
                            {
                                <tr>
                                    <td>
                                        @user.UserName
                                        @if (user.IsDummy)
                                        {
                                            <span class="badge text-bg-warning ms-1">@AdminUi.DummyBadge</span>
                                        }
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@(user.PrimaryDomainDisplayName ?? "—")</td>
                                    <td>
                                        @if (user.IsDummy)
                                        {
                                            <span class="text-muted"><i class="fas fa-ghost me-1"></i>@AdminUi.DummyLogins</span>
                                        }
                                        else if (user.ExternalLogins.Count == 0)
                                        {
                                            <span class="text-muted">@AdminUi.LoginsGeen</span>
                                        }
                                        else
                                        {
                                            @foreach (var login in user.ExternalLogins)
                                            {
                                                <span class="badge text-bg-info me-1">@login.Provider</span>
                                            }
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editUserModal"
                                                data-user-id="@user.Id"
                                                data-user-name="@user.UserName"
                                                data-user-role="@(user.OverrideRole ?? "")"
                                                data-user-provider-role="@(user.ProviderRole ?? "")"
                                                data-user-domain-id="@(user.PrimaryDomainId.ToString() ?? "")"
                                                data-external-logins='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(user.ExternalLogins))'
                                                onclick="openEditModalFromButton(this)">
                                            <i class="fas fa-edit"></i> @AdminUi.EditButton
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (Model.UsersByRole.Count == 0)
{
    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle"></i> @AdminUi.GeenUsersGevonden
    </div>
}

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" id="editUserForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">
                        <i class="fas fa-user-edit"></i> @AdminUi.EditUserKop
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@AdminUi.SluitenLabel"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Action" value="save" id="editFormAction" />
                    <input type="hidden" name="Section" value="users" />
                    <input type="hidden" name="EditUserId" id="editUserId" />
                    <input type="hidden" name="LoginIdToUnlink" id="loginIdToUnlink" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editUserName" class="form-label">@AdminUi.UsernameLabel</label>
                                <input type="text"
                                       class="form-control"
                                       id="editUserName"
                                       name="EditUserName"
                                       required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editUserRole" class="form-label">@AdminUi.OverrideRoleLabel</label>
                                <select class="form-select" id="editUserRole" name="EditUserRole">
                                    <option value="">@AdminUi.OverrideRoleGeen</option>
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                                <div class="form-text">@AdminUi.OverrideRoleHelp</div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editUserPrimaryDomainId" class="form-label">@AdminUi.PrimaryDomainLabel</label>
                                <select class="form-select" id="editUserPrimaryDomainId" name="EditUserPrimaryDomainId">
                                    <option value="">@AdminUi.GeenDomainOptie</option>
                                    @foreach (var domain in Model.Domains)
                                    {
                                        <option value="@domain.Id">@domain.DisplayName</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="editUserProviderRole" class="form-label">@AdminUi.ProviderRoleLabel</label>
                                <input type="text" class="form-control" id="editUserProviderRole" value="" readonly disabled />
                                <div class="form-text">@AdminUi.ProviderRoleHelp</div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <h6><i class="fas fa-sign-in-alt"></i> @AdminUi.ExternalLogins</h6>
                    <div id="externalLoginsContainer" class="mb-3">
                        <p class="text-muted" id="noLoginsMessage">@AdminUi.GeenExternalLogins</p>
                        <div id="loginsList"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@AdminUi.CancelButton</button>
                    <button type="submit" class="btn btn-primary" id="saveBtn">
                        <i class="fas fa-save"></i> @AdminUi.SaveChangesButton
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
