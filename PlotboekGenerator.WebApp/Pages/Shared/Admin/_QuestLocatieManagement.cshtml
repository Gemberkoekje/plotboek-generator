@model AdminModel
@using System.Globalization

@{
    var categorieLookup = Model.QuestLocatieCategorieen.ToDictionary(c => c.Id, c => c.DisplayName, StringComparer.Ordinal);
    var ernstOpties = Enum.GetValues<core.Enums.QuestLocatieErnst>().Where(e => e != core.Enums.QuestLocatieErnst.None).ToList();
}

<!-- Questlocatie Categorie Management Section -->
<div class="card mb-4">
    <div class="card-header text-bg-warning">
        <h5 class="mb-0">
            <i class="fas fa-layer-group"></i> @AdminUi.QuestLocatieCategorieenKop
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">
            @AdminUi.QuestLocatieCategorieenUitleg
        </p>

        <form method="post" class="mb-4">
            <input type="hidden" name="Action" value="saveQuestLocatieCategorie" />
            <input type="hidden" name="Section" value="questlocaties" />
            <input type="hidden" name="EditQuestLocatieCategorieId" id="editQuestLocatieCategorieId" value="" />
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="editQuestLocatieCategorieNaam" class="form-label">@AdminUi.NaamLabel</label>
                    <input type="text" class="form-control" id="editQuestLocatieCategorieNaam" name="EditQuestLocatieCategorieNaam" required />
                </div>
                <div class="col-md-4">
                    <label for="editQuestLocatieCategorieNotitie" class="form-label">@AdminUi.NotitieLabel</label>
                    <input type="text" class="form-control" id="editQuestLocatieCategorieNotitie" name="EditQuestLocatieCategorieNotitie" />
                </div>
                <div class="col-md-2">
                    <label for="editQuestLocatieCategorieErnst" class="form-label">@AdminUi.ErnstLabel</label>
                    <select class="form-select" id="editQuestLocatieCategorieErnst" name="EditQuestLocatieCategorieErnst">
                        @foreach (var ernst in ernstOpties)
                        {
                            <option value="@ernst">@ernst.Naam()</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="editQuestLocatieCategorieOrder" class="form-label">@AdminUi.Volgorde</label>
                    <input type="number" class="form-control" id="editQuestLocatieCategorieOrder" name="EditQuestLocatieCategorieOrder" min="0" value="0" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-warning" id="saveQuestLocatieCategorieBtn">
                        <i class="fas fa-plus"></i> @AdminUi.CategorieToevoegenButton
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="cancelEditQuestLocatieCategorieBtn" style="display: none;" onclick="cancelEditQuestLocatieCategorie()">
                        <i class="fas fa-times"></i> @AdminUi.AnnulerenButton
                    </button>
                    <small class="text-muted ms-2" id="questLocatieCategorieIdHint"></small>
                </div>
            </div>
        </form>

        @if (Model.QuestLocatieCategorieen.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>@AdminUi.NaamLabel</th>
                            <th>@AdminUi.NotitieLabel</th>
                            <th style="width: 110px;">@AdminUi.ErnstLabel</th>
                            <th style="width: 70px;">@AdminUi.KolomActies</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var categorie in Model.QuestLocatieCategorieen)
                        {
                            <tr>
                                <td>@categorie.Order</td>
                                <td>
                                    @categorie.DisplayName
                                    <br /><code class="small text-muted">@categorie.Id</code>
                                </td>
                                <td class="small">@categorie.Notitie</td>
                                <td>
                                    @if (categorie.Ernst == core.Enums.QuestLocatieErnst.Afgeraden)
                                    {
                                        <span class="badge text-bg-warning">@categorie.Ernst.Naam()</span>
                                    }
                                    else if (categorie.Ernst == core.Enums.QuestLocatieErnst.LetOp)
                                    {
                                        <span class="badge text-bg-info">@categorie.Ernst.Naam()</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@categorie.Ernst.Naam()</span>
                                    }
                                </td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-categorie-id="@categorie.Id"
                                            data-categorie-naam="@categorie.DisplayName"
                                            data-categorie-notitie="@categorie.Notitie"
                                            data-categorie-ernst="@categorie.Ernst"
                                            data-categorie-order="@categorie.Order"
                                            onclick="editQuestLocatieCategorie(this)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> @AdminUi.GeenCategorieen
            </div>
        }
    </div>
</div>

<!-- Questlocatie Management Section -->
<div class="card mb-4">
    <div class="card-header text-bg-warning">
        <h5 class="mb-0">
            <i class="fas fa-map-location-dot"></i> @AdminUi.SectieQuestLocaties
        </h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">
            @AdminUi.QuestLocatiesUitleg
            @Html.Raw(string.Format(CultureInfo.CurrentCulture, AdminUi.QuestLocatiesVerwijderenHtml, "<em>" + Html.Encode(AdminUi.ActiefLabel) + "</em>"))
            <br />
            @Html.Raw(string.Format(CultureInfo.CurrentCulture, AdminUi.QuestLocatiesOverlapHtml, "<em>" + Html.Encode(AdminUi.OverlaptMetLabel) + "</em>"))
        </p>

        <form method="post" class="mb-4">
            <input type="hidden" name="Action" value="saveQuestLocatie" />
            <input type="hidden" name="Section" value="questlocaties" />
            <input type="hidden" name="EditQuestLocatieId" id="editQuestLocatieId" value="" />
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="editQuestLocatieNaam" class="form-label">@AdminUi.NaamLabel</label>
                    <input type="text" class="form-control" id="editQuestLocatieNaam" name="EditQuestLocatieNaam" required />
                </div>
                <div class="col-md-4">
                    <label for="editQuestLocatieCategorie" class="form-label">@AdminUi.CategorieLabel</label>
                    <select class="form-select" id="editQuestLocatieCategorie" name="EditQuestLocatieCategorie" required>
                        <option value="">@AdminUi.CategorieKiezen</option>
                        @foreach (var categorie in Model.QuestLocatieCategorieen)
                        {
                            <option value="@categorie.Id">@categorie.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="editQuestLocatieOrder" class="form-label">@AdminUi.Volgorde</label>
                    <input type="number" class="form-control" id="editQuestLocatieOrder" name="EditQuestLocatieOrder" min="0" value="0" />
                </div>
                <div class="col-md-2">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="editQuestLocatieIsActief" name="EditQuestLocatieIsActief" value="true" checked />
                        <input type="hidden" name="EditQuestLocatieIsActief" value="false" />
                        <label class="form-check-label" for="editQuestLocatieIsActief">@AdminUi.ActiefLabel</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <label for="editQuestLocatieNotitie" class="form-label">@AdminUi.NotitieLabel</label>
                    <input type="text" class="form-control" id="editQuestLocatieNotitie" name="EditQuestLocatieNotitie" />
                </div>
                <div class="col-md-6">
                    <label for="editQuestLocatieConflicteertMet" class="form-label">@AdminUi.OverlaptMetMeerdereLabel</label>
                    <select class="form-select" id="editQuestLocatieConflicteertMet" name="EditQuestLocatieConflicteertMet" multiple size="4">
                        @foreach (var locatie in Model.QuestLocaties)
                        {
                            <option value="@locatie.Id">@locatie.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-warning" id="saveQuestLocatieBtn">
                        <i class="fas fa-plus"></i> @AdminUi.QuestLocatieToevoegenButton
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="cancelEditQuestLocatieBtn" style="display: none;" onclick="cancelEditQuestLocatie()">
                        <i class="fas fa-times"></i> @AdminUi.AnnulerenButton
                    </button>
                    <small class="text-muted ms-2" id="questLocatieIdHint"></small>
                </div>
            </div>
        </form>

        @if (Model.QuestLocaties.Count > 0)
        {
            <p class="text-muted small mb-2">@string.Format(CultureInfo.CurrentCulture, Model.QuestLocaties.Count == 1 ? AdminUi.QuestLocatiesAantalOne : AdminUi.QuestLocatiesAantalMany, Model.QuestLocaties.Count)</p>
            <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-hover table-sm align-middle">
                    <thead class="sticky-top bg-body-tertiary">
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>@AdminUi.NaamLabel</th>
                            <th>@AdminUi.CategorieLabel</th>
                            <th>@AdminUi.NotitieLabel</th>
                            <th>@AdminUi.OverlaptMetLabel</th>
                            <th style="width: 80px;">@AdminUi.ActiefLabel</th>
                            <th style="width: 70px;">@AdminUi.KolomActies</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var locatie in Model.QuestLocaties)
                        {
                            var overlapIds = Model.QuestLocatieOverlap.TryGetValue(locatie.Id, out var ids) ? ids : [];
                            <tr class="@(locatie.IsActief ? string.Empty : "text-muted")">
                                <td>@locatie.Order</td>
                                <td>
                                    @locatie.DisplayName
                                    <br /><code class="small text-muted">@locatie.Id</code>
                                </td>
                                <td class="small">
                                    @(categorieLookup.TryGetValue(locatie.CategorieId, out var categorieNaam) ? categorieNaam : locatie.CategorieId)
                                </td>
                                <td class="small">@locatie.Notitie</td>
                                <td class="small">
                                    @string.Join(", ", overlapIds.Select(id => Model.QuestLocaties.GetDisplayName(id)))
                                </td>
                                <td>
                                    @if (locatie.IsActief)
                                    {
                                        <span class="badge bg-success">@AdminUi.Ja</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@AdminUi.Nee</span>
                                    }
                                </td>
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            data-locatie-id="@locatie.Id"
                                            data-locatie-naam="@locatie.DisplayName"
                                            data-locatie-categorie="@locatie.CategorieId"
                                            data-locatie-notitie="@locatie.Notitie"
                                            data-locatie-order="@locatie.Order"
                                            data-locatie-actief="@locatie.IsActief.ToString().ToLowerInvariant()"
                                            data-locatie-overlap="@string.Join(",", locatie.ConflicteertMet)"
                                            onclick="editQuestLocatie(this)">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> @AdminUi.GeenQuestLocaties
            </div>
        }
    </div>
</div>
