@using Microsoft.AspNetCore.Identity
@using PlotboekGenerator.infrastructure.Models
@inject SignInManager<PlotboekUser> SignInManager
@inject UserManager<PlotboekUser> UserManager

@* Items of the crest bar's right-hand end (_Layout): who is signed in, and signing out. *@
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.UserName ?? User.Identity?.Name ?? "User";
    <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage your account">@displayName</a>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
        <button type="submit" class="nav-link">Logout</button>
    </form>
}
else
{
    <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
}
