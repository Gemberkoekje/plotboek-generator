@page
@model PlotboekGenerator.WebApp.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = Ui.LogoutTitel;
}

<header>
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                <button type="submit" class="btn btn-link p-0 align-baseline">@Ui.LogoutKlikHier</button>
            </form>
        }
        else
        {
            <p>@Ui.LogoutGelukt</p>
        }
    }
</header>
