<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>bdb1b1c0-42fb-481d-8be6-ab5a702878ea</UserSecretsId>
    <RootNamespace>PlotboekGenerator.core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlotboekGenerator.test" />
  </ItemGroup>

  <!-- Dutch is the neutral language; English is a satellite (Resources/*.en.resx). Each neutral
       file gets a typed class, so a missing key fails the build. See docs/i18n.md. -->
  <PropertyGroup>
    <NeutralLanguage>nl</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup Label="Resources">
    <EmbeddedResource Update="Resources/CoreTekst.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="PlotboekGenerator.core.Resources"
                      StronglyTypedClassName="CoreTekst" StronglyTypedFileName="$(IntermediateOutputPath)CoreTekst.Designer.cs" PublicClass="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**/*.docx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
    <PackageReference Include="Qowaiv" />
    <PackageReference Include="Qowaiv.CodeGeneration.SingleValueObjects" PrivateAssets="All" />
    <PackageReference Include="Qowaiv.DomainModel" />
    <PackageReference Include="Qowaiv.Validation.Fluent" />
  </ItemGroup>
</Project>
