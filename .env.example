# Plotboek Generator: settings for docker-compose.yml.
# Copy to .env and fill in. .env is git-ignored: never commit it.

# PostgreSQL
POSTGRES_USER=plotboek
POSTGRES_PASSWORD=          # REQUIRED: choose a strong password
POSTGRES_DB=plotboek

# The image tag to run (see the releases), and the port on this machine.
PLOTBOEK_VERSION=latest
WEBAPP_PORT=8080

# Serve below a path, e.g. /plotboek. Empty serves at the root.
PATH_BASE=

# Languages: nl and en. The default is the language a visitor gets when their browser asks for none
# of the supported ones, and the language of the Word export and of the example data on a first start.
DEFAULT_CULTURE=nl
SUPPORTED_CULTURES=nl,en

# Sign-in: one OpenID Connect provider (REQUIRED; there are no local accounts).
# Register the callback URL <your url><PATH_BASE>/signin-oidc-<scheme in lower case> at the provider.
OIDC_SCHEME=                # e.g. Google
OIDC_DISPLAY_NAME=          # the text on the login button; defaults to the scheme
OIDC_AUTHORITY=             # the issuer, e.g. https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=         # empty for a public (PKCE) client
OIDC_ROLE_CLAIM=            # optional: the claim that carries roles, e.g. roles

# Roles. Addresses listed here are Admin on every sign-in (comma separated).
ADMIN_EMAILS=
# Optional, with OIDC_ROLE_CLAIM: the claim values that grant each role (comma separated).
ROLE_ADMIN=
ROLE_USER=
ROLE_READER=
ROLE_NPC=
# Optional: the role of a sign-in nothing above grants one: Guest, NPC, Reader or User.
DEFAULT_ROLE=

# How the app presents your LARP.
BRANDING_NAME=
BRANDING_THEME_COLOR=
CONTACT_URL=                # where people reach you: a mailto: or https: link

# A public demo: a banner, an example plotboek, and POST /api/demo/reset to put it back.
DEMO_ENABLED=false
DEMO_RESET_API_KEY=         # protects the reset; it answers 503 while this is empty

# Optional integrations.
GEMINI_API_KEY=             # elevator-pitch suggestions
GOOGLE_CLIENT_ID=           # Google Drive upload: an OAuth client with Drive access
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SYNC_API_KEY=  # protects POST /api/sync-google-drive
