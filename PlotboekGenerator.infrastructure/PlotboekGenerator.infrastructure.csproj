<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="PlotboekGenerator.test" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PlotboekGenerator.infrastructure</RootNamespace>
  </PropertyGroup>

  <!-- Dutch is the neutral language; English is a satellite (Resources/*.en.resx). Each neutral
       file gets a typed class, so a missing key fails the build. See docs/i18n.md. -->
  <PropertyGroup>
    <NeutralLanguage>nl</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup Label="Resources">
    <EmbeddedResource Update="Resources/InfraTekst.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="PlotboekGenerator.infrastructure.Resources"
                      StronglyTypedClassName="InfraTekst" StronglyTypedFileName="$(IntermediateOutputPath)InfraTekst.Designer.cs" PublicClass="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**/*.docx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
    <PackageReference Include="Qowaiv" />
    <PackageReference Include="Qowaiv.DomainModel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PlotboekGenerator.application/PlotboekGenerator.Application.csproj" />
    <ProjectReference Include="../PlotboekGenerator.core/PlotboekGenerator.core.csproj" />
    <!-- Vendored from source, not consumed via NuGet - see ThirdParty/PdfPig/VENDORED.md. -->
    <ProjectReference Include="../ThirdParty/PdfPig/src/UglyToad.PdfPig/UglyToad.PdfPig.csproj" />
  </ItemGroup>

</Project>
